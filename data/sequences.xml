<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Own numbers for Proforma Invoices and Packing Lists. Commercial
         Invoices keep the official Odoo invoice number (account.move.name). -->
    <record id="seq_solven_proforma_invoice" model="ir.sequence">
        <field name="name">SOLVEN Proforma Invoice</field>
        <field name="code">solven.proforma.invoice</field>
        <field name="prefix">PI/%(range_year)s/</field>
        <field name="padding">4</field>
        <field name="use_date_range" eval="True"/>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_solven_packing_list" model="ir.sequence">
        <field name="name">SOLVEN Packing List</field>
        <field name="code">solven.packing.list</field>
        <field name="prefix">PL/%(range_year)s/</field>
        <field name="padding">4</field>
        <field name="use_date_range" eval="True"/>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
