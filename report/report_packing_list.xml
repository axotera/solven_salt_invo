<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        SOLVEN Packing List, matching the PACK reference layout. Number and date
        are the linked Commercial Invoice's own number and issue date.
        No document-reference block: the number already is the invoice number.
    -->
    <template id="solven_packing_list_document">
        <t t-set="company" t-value="doc.company_id"/>
        <t t-set="partner" t-value="doc.partner_id"/>
        <t t-set="lines" t-value="doc._solven_lines()"/>
        <t t-set="totals" t-value="doc._solven_pack_totals()"/>
        <t t-set="dest" t-value="doc._solven_destination_country()"/>
        <t t-set="left_pairs" t-value="doc._solven_pairs([
            ('Origin', doc.solven_origin_country_id.name),
            ('Destination', dest.name if dest else False),
        ])"/>
        <t t-set="right_pairs" t-value="doc._solven_pairs([
            ('Vessel / Voyage', doc.solven_vessel_voyage),
            ('Seal No', doc.solven_seal_number),
            ('Container No', doc.solven_container_number),
            ('Loading Berth', doc.solven_loading_berth),
            ('Stowage Plan Reference', doc.solven_stowage_reference),
            ('Port of Loading', doc.solven_port_loading),
            ('Port of Discharge', doc.solven_port_discharge),
            ('Mode of Transport', doc.solven_transport_mode),
            ('B/L / AWB No', doc.solven_bl_number),
            ('ETD', doc._solven_fmt_date(doc.solven_etd)),
            ('ATD', doc._solven_fmt_date(doc.solven_atd)),
            ('ACID No', doc.solven_acid_number),
        ])"/>
        <div class="article solven" t-att-data-oe-model="doc._name" t-att-data-oe-id="doc.id">
        <div class="sv-page">
            <div class="sv-probe"/>
            <div t-if="doc.state != 'done'" class="sv-status" t-out="'CANCELLED' if doc.state == 'cancel' else 'DRAFT - NOT ISSUED'"/>
            <t t-call="solven_export_invoice.solven_header">
                <t t-set="solven_title" t-value="'PACKING LIST'"/>
                <t t-set="solven_meta" t-value="[
                    ('Packing List No.', doc.solven_number),
                    ('Version', doc.solven_doc_version),
                    ('Date', doc._solven_fmt_date(doc.date), True),
                    ('Customer Code', partner.commercial_partner_id.ref),
                ]"/>
            </t>
            <t t-call="solven_export_invoice.solven_parties"/>

            <table class="sv-box sv-two">
                <colgroup><col style="width:100mm"/><col style="width:100mm"/></colgroup>
                <tr>
                    <td class="sv-pl-ship">
                        <table class="sv-inline">
                            <tr t-foreach="left_pairs" t-as="p">
                                <td class="k" t-out="p[0]"/><td class="v" t-out="p[1]"/>
                            </tr>
                        </table>
                    </td>
                    <td class="sv-pl-ship">
                        <table class="sv-inline">
                            <tr t-foreach="right_pairs" t-as="p">
                                <td class="k" t-out="p[0]"/><td class="v" dir="auto" t-out="p[1]"/>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>

            <table class="sv-box sv-goods">
                <colgroup><col style="width:20mm"/><col style="width:80mm"/><col style="width:30mm"/><col style="width:35mm"/><col style="width:35mm"/></colgroup>
                <thead><tr class="sv-strip"><td class="c" style="text-align:center">NO.</td><td>DESCRIPTION OF GOODS</td><td class="num">QUANTITY</td><td class="num">NET WEIGHT</td><td class="num">GROSS WEIGHT</td></tr></thead>
                <tbody>
                    <t t-foreach="lines" t-as="line">
                        <t t-set="tmpl" t-value="line.product_id.product_tmpl_id"/>
                        <t t-set="pack_text" t-value="line._solven_packing_text()"/>
                        <tr class="sv-item">
                            <td class="c" t-out="line_index + 1"/>
                            <td>
                                <div class="name" t-out="line.name"/>
                                <div class="sec" t-if="tmpl.solven_hs_code or pack_text">
                                    <t t-if="tmpl.solven_hs_code">HS <t t-out="tmpl.solven_hs_code"/></t>
                                    <t t-if="tmpl.solven_hs_code and pack_text"> · </t>
                                    <t t-if="pack_text">Packing: <t t-out="pack_text"/></t>
                                </div>
                                <div class="sec" t-if="line.marks or line.volume_cbm">
                                    <t t-if="line.marks">Marks: <t t-out="line.marks"/></t>
                                    <t t-if="line.marks and line.volume_cbm"> · </t>
                                    <t t-if="line.volume_cbm">Volume: <t t-out="doc._solven_fmt_num(line.volume_cbm, 3)"/> m³</t>
                                </div>
                            </td>
                            <td class="num"><t t-out="doc._solven_fmt_qty(line.quantity)"/> <t t-out="line.uom_id.name"/></td>
                            <td class="num"><t t-if="line.net_weight"><t t-out="doc._solven_fmt_num(line.net_weight)"/> kg</t></td>
                            <td class="num"><t t-if="line.gross_weight"><t t-out="doc._solven_fmt_num(line.gross_weight)"/> kg</t></td>
                        </tr>
                    </t>
                    <tr class="sv-fill"><td/><td/><td/><td/><td/></tr>
                </tbody>
            </table>

            <div class="sv-foot">
                <table class="sv-box">
                    <colgroup><col style="width:100mm"/><col style="width:30mm"/><col style="width:35mm"/><col style="width:35mm"/></colgroup>
                    <tr class="sv-pl-sum">
                        <td/>
                        <td class="num"><t t-if="totals['qty']"><t t-out="doc._solven_fmt_qty(totals['qty'])"/> <t t-out="totals['uom']"/></t></td>
                        <td class="num"><t t-if="totals['net']"><t t-out="doc._solven_fmt_num(totals['net'])"/> kg</t></td>
                        <td class="num"><t t-if="totals['gross']"><t t-out="doc._solven_fmt_num(totals['gross'])"/> kg</t></td>
                    </tr>
                </table>
                <table class="sv-box sv-two">
                    <tr class="sv-strip"><td>TOTALS</td><td class="num">SIGNATURE &amp; STAMP</td></tr>
                    <tr>
                        <td class="sv-pl-totals">
                            <table class="sv-inline">
                                <tr t-if="totals['qty']"><td class="k">QUANTITY</td><td class="v"><t t-out="doc._solven_fmt_qty(totals['qty'])"/> <t t-out="totals['uom']"/></td></tr>
                                <tr t-if="totals['packages']"><td class="k">PACKAGES</td><td class="v"><t t-out="doc._solven_fmt_qty(totals['packages'])"/> <t t-out="totals['package_type'] or ''"/></td></tr>
                                <tr t-if="totals['net']"><td class="k">NET WEIGHT</td><td class="v"><t t-out="doc._solven_fmt_num(totals['net'])"/> kg</td></tr>
                                <tr t-if="totals['gross']"><td class="k">GROSS WEIGHT</td><td class="v"><t t-out="doc._solven_fmt_num(totals['gross'])"/> kg</td></tr>
                                <tr t-if="totals['cbm']"><td class="k">VOLUME</td><td class="v"><t t-out="doc._solven_fmt_num(totals['cbm'], 3)"/> m³</td></tr>
                            </table>
                        </td>
                        <td class="sv-pl-totals"/>
                    </tr>
                </table>
            </div>
        </div>
        <t t-call="solven_export_invoice.solven_paginate"/>
        </div>
    </template>

    <template id="report_packing_list">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)"/>
                <t t-call="solven_export_invoice.solven_packing_list_document"/>
            </t>
        </t>
    </template>
</odoo>
