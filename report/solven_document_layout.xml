<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        SOLVEN A4 export documents, matching the approved reference
        (finaljob-mustbe.pdf / PACK.pdf).

        Page structure: header + FROM/TO + SHIPMENT | PAYMENT on top, a goods
        table that grows, and a footer block (amount, bank/signature, terms)
        anchored to the bottom of the last page. wkhtmltopdf has no reliable
        flex/grid, so blocks are tables and a small script (solven_paginate)
        paginates the goods rows, repeats the goods header on each page, fills
        the remaining height and prints "Page x / y".
    -->

    <!-- Header: logo, title, meta table, grey triangle. Expects solven_title, solven_meta [(label, value)]. -->
    <template id="solven_header">
        <table class="sv-box sv-head">
            <tr><td class="sv-header">
                <img class="sv-logo" src="/solven_export_invoice/static/img/logo03.svg" alt="Logo"/>
                <img class="sv-tri" src="/solven_export_invoice/static/img/tri03.svg" alt=""/>
                <div class="sv-title" t-out="solven_title"/>
                <table class="sv-meta">
                    <tr t-foreach="[m for m in solven_meta if m[1]]" t-as="m">
                        <td class="k" t-out="m[0]"/>
                        <td t-att-class="'v sm' if len(m) &gt; 2 and m[2] else 'v'" t-out="m[1]"/>
                    </tr>
                </table>
            </td></tr>
        </table>
    </template>

    <!-- FROM / TO, two equal halves. -->
    <template id="solven_parties">
        <t t-set="buyer" t-value="partner if (partner.street or partner.city) else partner.commercial_partner_id"/>
        <table class="sv-box sv-two">
            <tr class="sv-strip"><td t-out="from_label or 'FROM'"/><td t-out="to_label or 'TO'"/></tr>
            <tr>
                <td class="sv-party">
                    <b t-out="company.partner_id.name"/>
                    <p t-foreach="doc._solven_address_lines(company.partner_id)" t-as="al" t-out="al"/>
                    <p t-if="company.vat">Tax ID: <t t-out="company.vat"/></p>
                    <p t-if="company.phone">Tel: <t t-out="company.phone"/></p>
                    <p t-if="company.email" t-out="company.email"/>
                </td>
                <td class="sv-party">
                    <b t-out="partner.commercial_partner_id.name"/>
                    <p t-foreach="doc._solven_address_lines(buyer)" t-as="al" t-out="al"/>
                    <p t-if="partner.commercial_partner_id.vat">VAT: <t t-out="partner.commercial_partner_id.vat"/></p>
                    <p t-if="partner.phone or partner.commercial_partner_id.phone">Tel: <t t-out="partner.phone or partner.commercial_partner_id.phone"/></p>
                    <p t-if="partner.email or partner.commercial_partner_id.email" t-out="partner.email or partner.commercial_partner_id.email"/>
                    <p t-if="partner.parent_id">Attn: <t t-out="partner.name"/></p>
                    <p t-if="show_notify and doc.solven_notify_party_id" class="sv-notify">Notify Party: <t t-out="doc.solven_notify_party_id.name"/><t t-if="doc.solven_notify_party_id.city">, <t t-out="doc.solven_notify_party_id.city"/></t><t t-if="doc.solven_notify_party_id.country_id">, <t t-out="doc.solven_notify_party_id.country_id.name"/></t></p>
                </td>
            </tr>
        </table>
    </template>

    <!-- Label above value; one column for short lists, two for long ones,
         so empty optional fields shrink the block without unbalancing it. -->
    <template id="solven_pairs_block">
        <t t-set="ncol" t-value="1 if len(block_pairs) &lt;= 4 else 2"/>
        <table class="sv-pairs">
            <tr t-foreach="doc._solven_rows(block_pairs, ncol)" t-as="row">
                <td t-foreach="row" t-as="p">
                    <div class="l" t-out="p[0]"/>
                    <div class="v" t-out="p[1]"/>
                </td>
                <td t-if="len(row) &lt; ncol"/>
            </tr>
        </table>
    </template>

    <template id="solven_ship_pay">
        <table class="sv-box sv-two">
            <tr class="sv-strip"><td>SHIPMENT DETAILS</td><td>PAYMENT &amp; ORIGIN</td></tr>
            <tr>
                <td class="sv-flow">
                    <t t-call="solven_export_invoice.solven_pairs_block">
                        <t t-set="block_pairs" t-value="ship_pairs"/>
                    </t>
                </td>
                <td class="sv-flow">
                    <t t-call="solven_export_invoice.solven_pairs_block">
                        <t t-set="block_pairs" t-value="pay_pairs"/>
                    </t>
                </td>
            </tr>
        </table>
    </template>

    <!-- Pagination / anchored footer / page numbers (runs inside wkhtmltopdf). -->
    <template id="solven_paginate">
        <script type="text/javascript">
        (function () {
            function reset(page) {
                var junk = page.querySelectorAll('tr.sv-break, tr.sv-rephead, tr.sv-fill-extra, .sv-pageno');
                for (var i = 0; i &lt; junk.length; i++) { junk[i].parentNode.removeChild(junk[i]); }
                var f = page.querySelector('tr.sv-fill:not(.sv-fill-extra)');
                if (f) { f.style.height = '0px'; }
                page.style.height = '';
            }
            function run() {
                /* Idempotent: undo and redo, so late web fonts or images are picked up. */
                var pages = document.querySelectorAll('.sv-page');
                for (var i = 0; i &lt; pages.length; i++) { reset(pages[i]); paginate(pages[i]); }
            }
            function top(el) { return el.getBoundingClientRect().top + (window.pageYOffset || 0); }
            function paginate(page) {
                var probe = page.querySelector('.sv-probe');
                probe.style.display = '';
                var mm = probe.getBoundingClientRect().height / 1000.0;
                probe.style.display = 'none';
                var P = 297 * mm, T = 8 * mm, B = 12 * mm;
                var table = page.querySelector('table.sv-goods');
                var body = table.tBodies[0];
                var head = table.tHead.rows[0];
                var filler = body.querySelector('tr.sv-fill:not(.sv-fill-extra)');
                var foot = page.querySelector('.sv-foot');
                var ncol = head.cells.length;
                var off = top(page);
                var pageEnd = P; /* document coordinates: page k ends at k * P */
                function spacer(beforeRow, h, cls) {
                    var tr = document.createElement('tr');
                    tr.className = cls;
                    var td = document.createElement('td');
                    td.colSpan = ncol;
                    td.style.height = h + 'px';
                    tr.appendChild(td);
                    body.insertBefore(tr, beforeRow);
                }
                var starts = [0]; /* document y where each printed page begins */
                function brk(beforeRow) {
                    /* Close this page well above its edge, then force a page break: the
                       next printed page begins exactly at the forced-break row. */
                    spacer(beforeRow, Math.max(0, Math.floor(pageEnd - top(beforeRow)) - 10), 'sv-break');
                    spacer(beforeRow, Math.round(T), 'sv-break sv-break2');
                    var sp2 = beforeRow.previousSibling;
                    sp2.style.pageBreakBefore = 'always';
                    var start = top(sp2);
                    starts.push(start);
                    /* Repeat the full document header (logo, title, number, date) on every new page. */
                    var src = page.querySelector('table.sv-head');
                    if (src) {
                        var hr = document.createElement('tr');
                        hr.className = 'sv-rephead sv-rephead-box';
                        var hc = document.createElement('td');
                        hc.colSpan = ncol;
                        hc.style.padding = '0';
                        hc.style.border = '0';
                        hc.appendChild(src.cloneNode(true));
                        hr.appendChild(hc);
                        body.insertBefore(hr, beforeRow);
                    }
                    var h = head.cloneNode(true);
                    h.className += ' sv-rephead';
                    body.insertBefore(h, beforeRow);
                    pageEnd = start + P;
                }
                var rows = [];
                for (var r = 0; r &lt; body.rows.length; r++) {
                    if (body.rows[r].className.indexOf('sv-item') &gt;= 0) { rows.push(body.rows[r]); }
                }
                for (var k = 0; k &lt; rows.length; k++) {
                    var row = rows[k];
                    if (top(row) + row.offsetHeight &gt; pageEnd - B) { brk(row); }
                }
                var fh = foot.offsetHeight;
                if (top(filler) + fh &gt; pageEnd - B) {
                    /* Footer does not fit: close this page's table, continue on the next page. */
                    filler.style.height = Math.max(0, pageEnd - B - top(filler)) + 'px';
                    var nf = filler.cloneNode(true);
                    nf.className = 'sv-fill sv-fill-extra';
                    body.appendChild(nf);
                    brk(nf);
                    filler = nf;
                }
                filler.style.height = Math.max(0, pageEnd - B - fh - top(filler)) + 'px';
                var total = starts.length;
                for (var n = 0; n &lt; total; n++) {
                    var d = document.createElement('div');
                    d.className = 'sv-pageno';
                    d.style.top = (starts[n] + P - B + 3 * mm - off) + 'px';
                    d.innerHTML = 'Page ' + (n + 1) + ' / ' + total;
                    page.appendChild(d);
                }
                page.style.height = Math.floor(pageEnd - off - 12) + 'px';
            }
            /* Web fonts can apply after 'load'; re-run until wkhtmltopdf prints
               (Odoo passes javascript-delay 1000 ms). */
            function later() {
                run();
                var n = 0;
                var iv = setInterval(function () { run(); if (++n &gt; 30) { clearInterval(iv); } }, 60);
            }
            if (document.readyState === 'complete') { later(); } else { window.addEventListener('load', later); }
        })();
        </script>
    </template>

    <!-- Quotation / Proforma / Commercial Invoice -->
    <template id="solven_document">
        <t t-set="company" t-value="doc.company_id"/>
        <t t-set="partner" t-value="doc.partner_id"/>
        <t t-set="currency" t-value="doc.currency_id"/>
        <t t-set="ship_pairs" t-value="doc._solven_pairs(solven_shipment)"/>
        <t t-set="pay_pairs" t-value="doc._solven_pairs(solven_payment)"/>
        <t t-set="lines" t-value="doc._solven_lines()"/>
        <t t-set="bank" t-value="doc._solven_bank_accounts()"/>
        <t t-set="terms" t-value="doc._solven_terms()"/>
        <div class="article solven" t-att-data-oe-model="doc._name" t-att-data-oe-id="doc.id">
        <div class="sv-page">
            <div class="sv-probe"/>
            <t t-call="solven_export_invoice.solven_header"/>
            <t t-call="solven_export_invoice.solven_parties"/>
            <t t-call="solven_export_invoice.solven_ship_pay"/>

            <table class="sv-box sv-goods">
                <colgroup><col style="width:100mm"/><col style="width:29mm"/><col style="width:29mm"/><col style="width:42mm"/></colgroup>
                <thead><tr class="sv-strip"><td>DESCRIPTION OF GOODS</td><td class="num">QUANTITY</td><td class="num">UNIT PRICE</td><td class="num">TOTAL</td></tr></thead>
                <tbody>
                    <t t-foreach="lines" t-as="line">
                        <t t-set="qty_uom" t-value="doc._solven_line_qty(line)"/>
                        <t t-set="tmpl" t-value="line.product_id.product_tmpl_id"/>
                        <t t-set="pname" t-value="line.product_id.name or line.name"/>
                        <t t-set="extra" t-value="line.name if line.product_id and line.name and line.name.strip() != (line.product_id.display_name or '').strip() and line.name.strip() != (line.product_id.name or '').strip() else False"/>
                        <tr class="sv-item">
                            <td>
                                <div class="name" t-out="pname"/>
                                <div class="sec" t-if="extra" t-out="extra"/>
                                <div class="sec" t-if="tmpl.solven_hs_code or tmpl.solven_packing">
                                    <t t-if="tmpl.solven_hs_code">HS <t t-out="tmpl.solven_hs_code"/></t>
                                    <t t-if="tmpl.solven_hs_code and tmpl.solven_packing"> · </t>
                                    <t t-if="tmpl.solven_packing">Packing: <t t-out="tmpl.solven_packing"/></t>
                                </div>
                                <div class="sec" t-if="tmpl.weight or tmpl.solven_gross_weight">
                                    <t t-if="tmpl.weight">Net Wt: <t t-out="doc._solven_fmt_num(tmpl.weight * qty_uom[0])"/> kg</t>
                                    <t t-if="tmpl.weight and tmpl.solven_gross_weight"> · </t>
                                    <t t-if="tmpl.solven_gross_weight">Gross Wt: <t t-out="doc._solven_fmt_num(tmpl.solven_gross_weight * qty_uom[0])"/> kg</t>
                                </div>
                                <div class="sec" t-if="line.discount">Discount: <t t-out="doc._solven_fmt_qty(line.discount)"/>%</div>
                            </td>
                            <td class="num"><t t-out="doc._solven_fmt_qty(qty_uom[0])"/> <t t-out="qty_uom[1].name"/></td>
                            <td class="num"><t t-out="line.price_unit" t-options="{'widget': 'float', 'decimal_precision': 'Product Price'}"/></td>
                            <td class="num"><t t-out="line.price_subtotal" t-options="{'widget': 'float', 'precision': currency.decimal_places}"/></td>
                        </tr>
                    </t>
                    <tr class="sv-fill"><td/><td/><td/><td/></tr>
                </tbody>
            </table>

            <div class="sv-foot">
                <table class="sv-box sv-totals">
                    <tr>
                        <td class="sv-words-cell">
                            <div class="sv-zone">AMOUNT IN WORDS</div>
                            <div class="sv-words"><t t-out="currency.amount_to_text(doc.amount_total)"/> Only</div>
                        </td>
                        <td class="sv-sum-cell">
                            <t t-if="doc.amount_tax">
                                <table class="sv-taxes">
                                    <tr><td>SUB TOTAL</td><td class="num"><t t-out="currency.name"/> <t t-out="doc.amount_untaxed" t-options="{'widget': 'float', 'precision': currency.decimal_places}"/></td></tr>
                                    <tr><td>TAXES</td><td class="num"><t t-out="currency.name"/> <t t-out="doc.amount_tax" t-options="{'widget': 'float', 'precision': currency.decimal_places}"/></td></tr>
                                </table>
                                <div class="sv-zone num">TOTAL</div>
                            </t>
                            <div t-else="" class="sv-zone num">SUB TOTAL</div>
                            <div class="sv-amount"><t t-out="currency.name"/> <t t-out="doc.amount_total" t-options="{'widget': 'float', 'precision': currency.decimal_places}"/></div>
                        </td>
                    </tr>
                </table>
                <table class="sv-box sv-two">
                    <tr class="sv-strip"><td>BANK DETAILS</td><td>SIGNATURE &amp; STAMP</td></tr>
                    <tr>
                        <td class="sv-party sv-h30">
                            <t t-if="bank">
                                <p>Beneficiary: <t t-out="bank.partner_id.name or company.name"/></p>
                                <p t-if="bank.bank_id">Bank: <t t-out="bank.bank_id.name"/></p>
                                <p><t t-out="'IBAN' if (bank.acc_type == 'iban') else 'Account No.'"/>: <t t-out="bank.acc_number"/></p>
                                <p t-if="bank.bank_bic">SWIFT: <t t-out="bank.bank_bic"/></p>
                                <p>Account Currency: <t t-out="(bank.currency_id or currency).name"/></p>
                            </t>
                        </td>
                        <td class="sv-party sv-h30"/>
                    </tr>
                </table>
                <table class="sv-box">
                    <tr class="sv-strip"><td>TERMS AND CONDITIONS</td></tr>
                    <tr>
                        <td class="sv-terms">
                            <div t-if="terms" t-out="terms"/>
                            <t t-set="pterm" t-value="doc._solven_payment_term()"/>
                            <div t-if="pterm.note" t-out="pterm.note"/>
                        </td>
                    </tr>
                </table>
            </div>
        </div>
        <t t-call="solven_export_invoice.solven_paginate"/>
        </div>
    </template>
</odoo>
