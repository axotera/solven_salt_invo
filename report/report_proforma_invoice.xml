<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_proforma_invoice">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)"/>
                <t t-call="solven_export_invoice.solven_document">
                    <t t-set="solven_title" t-value="'PROFORMA INVOICE'"/>
                    <t t-set="solven_no_label" t-value="'Proforma Invoice No.'"/>
                    <!-- Issued once (see report/proforma_invoice.py); stable on reprint. -->
                    <t t-set="solven_no" t-value="doc.solven_proforma_number"/>
                    <t t-set="solven_date_label" t-value="'Proforma Date'"/>
                    <t t-set="solven_date" t-value="doc._solven_fmt_date(doc.solven_proforma_date)"/>
                    <t t-set="solven_shipment" t-value="[
                        ('Country of Origin', doc.solven_origin_country_id.name),
                        ('Port of Loading', doc.solven_port_loading),
                        ('Port of Discharge', doc.solven_port_discharge),
                        ('Incoterms', doc._solven_incoterm_label()),
                        ('Mode of Transport', doc.solven_transport_mode),
                        ('ETD', doc._solven_fmt_date(doc.solven_etd)),
                    ]"/>
                    <t t-set="solven_payment" t-value="[
                        ('Payment Terms', doc.payment_term_id.name),
                        ('Currency', doc.currency_id.name),
                        ('Sales Order', doc.name),
                        ('Customer PO', doc._solven_customer_po()),
                        ('L/C No.', doc.solven_lc_number),
                        ('ACID No.', doc.solven_acid_number, doc.solven_acid_required),
                    ]"/>
                </t>
            </t>
        </t>
    </template>
</odoo>
