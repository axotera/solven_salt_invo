<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_solven_export" model="ir.ui.view">
        <field name="name">product.template.form.solven.export</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Export &amp; Packing" name="solven_export">
                    <group>
                        <group string="Customs">
                            <field name="solven_hs_code"/>
                            <field name="solven_packing" placeholder="e.g. 15 kg telescopic cartons"/>
                        </group>
                        <group string="Default packaging">
                            <field name="solven_package_type"/>
                            <field name="solven_units_per_package"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
