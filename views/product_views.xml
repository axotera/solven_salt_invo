<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_solven_export" model="ir.ui.view">
        <field name="name">product.template.form.solven.export</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Export" name="solven_export">
                    <group>
                        <group>
                            <field name="solven_hs_code"/>
                            <field name="solven_packing"/>
                        </group>
                        <group>
                            <field name="weight" string="Net Weight per Unit"/>
                            <field name="solven_gross_weight"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
