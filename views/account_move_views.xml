<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_solven_export" model="ir.ui.view">
        <field name="name">account.move.form.solven.export</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Export Details" name="solven_export"
                      invisible="move_type not in ('out_invoice', 'out_refund')">
                    <group>
                        <group string="Shipment">
                            <field name="solven_port_loading"/>
                            <field name="solven_port_discharge"/>
                            <field name="solven_transport_mode"/>
                            <field name="solven_vessel_voyage"/>
                            <field name="solven_bl_number"/>
                            <field name="solven_container_number"/>
                            <field name="solven_etd"/>
                            <field name="solven_atd"/>
                        </group>
                        <group string="Payment &amp; Origin">
                            <field name="solven_origin_country_id"/>
                            <field name="solven_lc_number"/>
                            <field name="solven_doc_version"/>
                        </group>
                        <group string="Document References">
                            <field name="solven_proforma_number"/>
                            <field name="solven_proforma_date"/>
                            <field name="solven_acid_required"/>
                            <field name="solven_acid_number"/>
                        </group>
                    </group>
                    <field name="solven_packing_list_ids" readonly="1">
                        <list>
                            <field name="name"/>
                            <field name="date"/>
                            <field name="sale_order_id"/>
                            <field name="state" widget="badge"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
